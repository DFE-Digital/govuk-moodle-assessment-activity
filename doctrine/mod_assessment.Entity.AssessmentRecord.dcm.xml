<?xml version="1.0"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="mod_assessment\Entity\AssessmentRecord" table="mdl_assessment_record">
    <id name="id" type="integer">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="userId" type="bigint" nullable="false"/>
    <field name="createdAt" type="datetime" nullable="true"/>
    <many-to-one field="assessment" target-entity="mod_assessment\Entity\Assessment" inversed-by="assessmentRecords">
      <join-columns>
        <join-column name="assessment_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <one-to-many field="assessmentRecordItems" target-entity="mod_assessment\Entity\AssessmentRecordItem" mapped-by="assessmentRecord" orphan-removal="true">
      <cascade>
        <cascade-persist/>
        <cascade-remove/>
      </cascade>
    </one-to-many>
  </entity>
</doctrine-mapping>
