<?xml version="1.0"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="mod_assessment\Entity\AssessmentTypeSection" table="mdl_assessment_type_section">
    <id name="id" type="integer">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="name" type="string" length="255" nullable="false"/>
    <field name="guidanceBefore" type="text" nullable="true"/>
    <field name="guidanceAfter" type="text" nullable="true"/>
    <field name="displayOrder" type="integer" nullable="true"/>
    <many-to-one field="assessmentType" target-entity="mod_assessment\Entity\AssessmentType" inversed-by="assessmentTypeSections">
      <join-columns>
        <join-column name="assessment_type_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="parentAssessmentTypeSection" target-entity="mod_assessment\Entity\AssessmentTypeSection" inversed-by="childAssessmentTypeSections">
      <join-columns>
        <join-column name="parent_assessment_type_section_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
    <one-to-many field="childAssessmentTypeSections" target-entity="mod_assessment\Entity\AssessmentTypeSection" mapped-by="parentAssessmentTypeSection"/>
    <one-to-many field="assessmentTypeItems" target-entity="mod_assessment\Entity\AssessmentTypeItem" mapped-by="assessmentTypeSection" orphan-removal="true">
      <cascade>
        <cascade-persist/>
        <cascade-remove/>
      </cascade>
      <order-by>
        <order-by-field name="displayOrder" direction="ASC"/>
      </order-by>
    </one-to-many>
  </entity>
</doctrine-mapping>
