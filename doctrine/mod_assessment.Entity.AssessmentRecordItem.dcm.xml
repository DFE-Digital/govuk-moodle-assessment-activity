<?xml version="1.0"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="mod_assessment\Entity\AssessmentRecordItem" table="mdl_assessment_record_item">
    <id name="id" type="integer">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="value" type="json" nullable="true"/>
    <many-to-one field="assessmentTypeItem" target-entity="mod_assessment\Entity\AssessmentTypeItem">
      <join-columns>
        <join-column name="assessment_type_item_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="assessmentRecord" target-entity="mod_assessment\Entity\AssessmentRecord" inversed-by="assessmentRecordItems">
      <join-columns>
        <join-column name="assessment_record_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
