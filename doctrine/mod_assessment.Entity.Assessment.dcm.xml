<?xml version="1.0"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="mod_assessment\Entity\Assessment" table="mdl_assessment">
    <id name="id" type="integer">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="course" type="bigint" nullable="false">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="name" type="string" length="255" nullable="true"/>
    <field name="createdAt" type="datetime" nullable="true"/>
    <field name="updatedAt" type="datetime" nullable="true"/>
    <field name="timecreated" type="bigint" nullable="false">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="timemodified" type="bigint" nullable="false">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="intro" type="text" nullable="true"/>
    <field name="introformat" type="smallint" nullable="false">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <many-to-one field="assessmentType" target-entity="mod_assessment\Entity\AssessmentType">
      <join-columns>
        <join-column name="assessment_type_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <one-to-many field="assessmentRecords" target-entity="mod_assessment\Entity\AssessmentRecord" mapped-by="assessment"/>
  </entity>
</doctrine-mapping>
