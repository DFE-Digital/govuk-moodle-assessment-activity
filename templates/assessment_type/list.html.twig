{% import '@govuk-frontend-twig/components/table.html.twig' as govukTable %}

<a href="{{ path('assessment_type_new') }}">Create assessment type</a>

{%
set head = [
  { text: 'Assessment type' },
  { text: '' },
]
%}

{% set rows = [] %}
{% for assessmentType in assessmentTypes %}
  {% set rows = rows|merge([[
    { text: assessmentType.name },
    { html: '<a href="' ~ path('assessment_type_edit', {'id': assessmentType.id}) ~ '">Edit</a>' },
  ]]) %}
{% endfor %}

{{ govukTable.govukTable({
  caption: "Assessment types",
  captionClasses: "govuk-table__caption--m",
  firstCellIsHeader: true,
  head: head,
  rows: rows
}) }}
