{% import '@govuk-frontend-twig/components/table.html.twig' as govukTable %}

<div class="gds-container">
  <h2 class="govuk-heading-m">
    {% if assessmentTypeSection.id %}
      Edit section - {{ assessmentTypeSection.name }}
    {% else %}
      {{ assessmentTypeSection.assessmentType.name }}: Add section
    {% endif %}
  </h2>

  {% for type, messages in flash_messages %}
    {% for message in messages %}
      <div class="alert alert-{{ type }}">
        {{ message }}
      </div>
    {% endfor %}
  {% endfor %}

  {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.guidance_before) }}
    {{ form_row(form.guidance_after) }}

    {% if assessmentTypeSection.id %}
      <h3 class="govuk-heading-s">Fields</h3>

      <p><a href="{{ path('assessment_type_item_new', {'assessmentTypeSectionId': assessmentTypeSection.id}) }}?type=field">Add field</a></p>

      {%
      set head = [
        { text: 'Name' },
        { text: 'Type' },
        { text: 'Description' },
        { text: '' },
      ]
      %}

      {% set rows = [] %}
      {% for assessmentTypeItem in assessmentTypeSection.assessmentTypeItems %}
        {% set rows = rows|merge([[
          { text: assessmentTypeItem.name },
          { text: assessmentTypeItem|classShort == 'AssessmentTypeField' ? assessmentTypeItem.dataType : assessmentTypeItem|classShort },
          { text: assessmentTypeItem.description },
          { html: '<a href="' ~ path('assessment_type_item_edit', {'id': assessmentTypeItem.id}) ~ '">Edit</a>' },
        ]]) %}
      {% endfor %}

      {{ govukTable.govukTable({
        caption: "Fields",
        captionClasses: "govuk-table__caption--m",
        firstCellIsHeader: true,
        head: head,
        rows: rows
      }) }}
    {% endif %}

    <div style="display:none;">
      {{ form_rest(form) }}
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">
      Save
    </button>
  {{ form_end(form) }}
</div>
