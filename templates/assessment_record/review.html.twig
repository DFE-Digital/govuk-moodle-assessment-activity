{% import '@govuk-frontend-twig/components/table.html.twig' as govukTable %}

<div class="gds-container">
  <form method="POST">
    <h1 class="govuk-heading-l">Review assessment record</h1>

    {% set assessmentType = assessmentRecord.assessment.assessmentType %}

    {% for assessmentTypeSection in assessmentType.assessmentTypeSections %}
      {% set rows = [] %}
      {% for assessmentTypeItem in assessmentTypeSection.assessmentTypeItems %}
        {# Within the AssessmentRecord, locate the AssessmentRecordItem that matches the AssessmentTypeItem #}
        {% set assessmentRecordItemForAssessmentTypeItem = null %}
        {% for assessmentRecordItem in assessmentRecord.assessmentRecordItems %}
          {% if assessmentRecordItem.assessmentTypeItem.id == assessmentTypeItem.id %}
            {% set assessmentRecordItemForAssessmentTypeItem = assessmentRecordItem %}
          {% endif %}
        {% endfor %}
        {% if assessmentRecordItemForAssessmentTypeItem %}
          {% if assessmentTypeItem.dataType == 'checkbox' %}
            {% set assesmentRecordItemValue = assessmentRecordItemForAssessmentTypeItem.value ? 'Yes' : 'No' %}
          {% else %}
            {% set assesmentRecordItemValue = assessmentRecordItemForAssessmentTypeItem.value %}
          {% endif %}

          {% set url = assessmentRecord.id ?
              path('assessment_record_edit', { id: assessmentRecord.id }) :
              path('assessment_record_new', { assessmentId: assessmentRecord.assessment.id })
          %}

          {% set rows = rows|merge([[
            { text: assessmentTypeItem.description },
            { text: assesmentRecordItemValue },
            { html: '<a href="' ~ url ~ '?change=1">Change</a>' },
          ]]) %}
        {% endif %}
      {% endfor %}

      {{ govukTable.govukTable({
        caption: assessmentTypeSection.name,
        captionClasses: "govuk-table__caption--m",
        firstCellIsHeader: true,
        rows: rows
      }) }}
    {% endfor %}

    <button type="submit" class="govuk-button" data-module="govuk-button">
      Confirm
    </button>
  </form>
</div>
