<table class="govuk-table">
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header">Title</th>
      <th scope="col" class="govuk-table__header">Observation date</th>
      <th scope="col" class="govuk-table__header">Last edited</th>
      <th scope="col" class="govuk-table__header"></th>
      <th scope="col" class="govuk-table__header">Actions</th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    {% for assessmentRecord in assessmentRecords %}
      <tr class="govuk-table__row">
        <th scope="row" class="govuk-table__header govuk-body-s">{{ assessmentRecord.getAssessmentRecordItemValue('observation_name') }}</th>
        <td class="govuk-table__cell govuk-body-s">DATE</td>
        <td class="govuk-table__cell govuk-body-s">{{ assessmentRecord.createdAt ? assessmentRecord.createdAt.format('j M Y') : ''}}</td>
        <td class="govuk-table__cell govuk-body-s"><a href="#">Send to observer</a></td>
        <td class="govuk-table__cell">
          <a href="{{ path('assessment_record_edit', {'id': assessmentRecord.id}) }}">Edit</a>
          <a href="{{ path('assessment_record_delete', {'id': assessmentRecord.id}) }}">Delete</a>
          ##more##
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<a
  class="btn btn-primary mx1"
  href="{{ path('assessment_record_new', {'assessmentId': assessment.id}) }}"
  role="button"
>
  Add new direct observation
</a>